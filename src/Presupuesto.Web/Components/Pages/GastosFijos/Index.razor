@page "/gastosfijos"
@using Presupuesto.Application.DTOs
@using Presupuesto.Application.Services
@using Presupuesto.Domain.Enums
@inject IGastoFijoService GastoFijoService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Gastos Fijos - Control de Presupuesto</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0 fw-bold">Gastos Fijos</h2>
            <p class="text-muted mb-0">Administración de conceptos recurrentes</p>
        </div>
        <a href="/gastosfijos/crear" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Nuevo Gasto Fijo
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            @if (cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (!gastosFijos.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-calendar-x fs-1 d-block mb-3"></i>
                    <h5>No hay gastos fijos registrados</h5>
                    <p>Agrega conceptos recurrentes para usarlos en el registro de gastos.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4 py-3">Concepto</th>
                                <th class="py-3">Monto</th>
                                <th class="py-3">Frecuencia</th>
                                <th class="py-3">Fecha</th>
                                <th class="py-3">Categoría</th>
                                <th class="py-3 text-center">Estado</th>
                                <th class="px-4 py-3 text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var gasto in GastosFijosPaginados)
                            {
                                <tr>
                                    <td class="px-4 fw-medium">@gasto.Concepto</td>
                                    <td>@gasto.Monto.ToString("C2")</td>
                                    <td>
                                        <span class="badge @GetFrecuenciaBadgeClass(gasto.Frecuencia)">
                                            @gasto.Frecuencia
                                        </span>
                                    </td>
                                    <td>@gasto.Fecha.ToShortDateString()</td>
                                    <td>@gasto.CategoriaNombre</td>
                                    <td class="text-center">
                                        @if (gasto.Activo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">Inactivo</span>
                                        }
                                    </td>
                                    <td class="px-4 text-end">
                                        <div class="btn-group">
                                            <a href="/gastosfijos/editar/@gasto.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarEliminar(gasto)" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td class="px-4 fw-bold text-end">Total:</td>
                                <td class="fw-bold text-success">@gastosFijos.Sum(g => g.Monto).ToString("C2")</td>
                                <td colspan="5"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                @if (TotalPaginas >= 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="text-muted small">
                            Mostrando @GastosFijosPaginados.Count() de @gastosFijos.Count() registros
                        </div>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => CambiarPagina(paginaActual - 1)">Anterior</button>
                                </li>
                                @for (int i = 1; i <= TotalPaginas; i++)
                                {
                                    var pageIndex = i;
                                    <li class="page-item @(paginaActual == pageIndex ? "active" : "")">
                                        <button class="page-link" @onclick="() => CambiarPagina(pageIndex)">@pageIndex</button>
                                    </li>
                                }
                                <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => CambiarPagina(paginaActual + 1)">Siguiente</button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>

@if (gastoAEliminar != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-bottom-0 pt-4 pb-0 px-4">
                    <h5 class="modal-title fw-bold">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <p class="mb-0">¿Estás seguro de que deseas eliminar el gasto fijo <strong>@gastoAEliminar.Concepto</strong>?</p>
                </div>
                <div class="modal-footer border-top-0 pb-4 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CancelarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger rounded-pill px-4" @onclick="EliminarGastoFijo">
                        @if (eliminando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Eliminando...</span>
                        }
                        else
                        {
                            <span>Eliminar</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<GastoFijoDto> gastosFijos = new List<GastoFijoDto>();
    private bool cargando = true;
    private GastoFijoDto? gastoAEliminar;
    private bool eliminando = false;

    // Paginación
    private int paginaActual = 1;
    private int itemsPorPagina = 10;
    
    private IEnumerable<GastoFijoDto> GastosFijosPaginados => 
        gastosFijos.Skip((paginaActual - 1) * itemsPorPagina).Take(itemsPorPagina);

    private int TotalPaginas => 
        (int)Math.Ceiling(gastosFijos.Count() / (double)itemsPorPagina);

    private void CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina >= 1 && nuevaPagina <= TotalPaginas)
        {
            paginaActual = nuevaPagina;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarGastosFijos();
    }

    private async Task CargarGastosFijos()
    {
        try
        {
            gastosFijos = await GastoFijoService.GetAllAsync();
        }
        finally
        {
            cargando = false;
        }
    }

    private void ConfirmarEliminar(GastoFijoDto gasto)
    {
        gastoAEliminar = gasto;
    }

    private void CancelarEliminar()
    {
        gastoAEliminar = null;
    }

    private async Task EliminarGastoFijo()
    {
        if (gastoAEliminar != null)
        {
            eliminando = true;
            try
            {
                await GastoFijoService.DeleteAsync(gastoAEliminar.Id);
                await CargarGastosFijos();
                gastoAEliminar = null;
            }
            finally
            {
                eliminando = false;
            }
        }
    }

    private string GetFrecuenciaBadgeClass(FrecuenciaGasto freq)
    {
        return freq switch
        {
            FrecuenciaGasto.Mensual => "bg-info text-dark",
            FrecuenciaGasto.Trimestral => "bg-warning text-dark",
            FrecuenciaGasto.Semestral => "bg-primary",
            FrecuenciaGasto.Anual => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}
